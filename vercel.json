{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "data/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/api/(.*)", "destination": "/api?__route=/api/$1" },
    { "source": "/webhooks/(.*)", "destination": "/api?__route=/webhooks/$1" },
    { "source": "/lender-a/(.*)", "destination": "/api?__route=/lender-a/$1" },
    { "source": "/lender-b/(.*)", "destination": "/api?__route=/lender-b/$1" },
    { "source": "/hosted/(.*)", "destination": "/api?__route=/hosted/$1" },
    { "source": "/sandbox/(.*)", "destination": "/api?__route=/sandbox/$1" },
    { "source": "/((?!api|webhooks|lender-a|lender-b|hosted|sandbox|css|js|shared|data|docs|assets|favicon.ico).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js|shared)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
